t(0,0,320,110);v+=0.6;y=Math.min(80,y+v);o-=4+s/300;if(o<-20){o=320+Math.random()*120;}s++;\nx.fillStyle=getComputedStyle(document.body).color;x.fillRect(30,y,20,20);x.fillRect(o,85,14,15);x.fillText('Score '+Math.floor(s/10),250,14);\nif(o<50&&o>16&&y>66){dead=true;x.fillText('Tap to restart',120,50);return setTimeout(function(){requestAnimationFrame(w)},50);}requestAnimationFrame(f);}\nfunction w(){if(!dead)f();else requestAnimationFrame(w);}f();})();</script></div></body></html>","showBranding":false}